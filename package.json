{
	"name": "portfolio-site",
	"version": "0.0.1",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.7.0",
		"@typescript-eslint/parser": "^8.71.2",
		"cssnano": "^8.0.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-tailwindcss": "4.0.0-alpha.2",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"type": "module",
	"dependencies": {
		"svelte-icons": "^2.1.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
